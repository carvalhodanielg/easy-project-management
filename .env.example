# Copy this file to .env and fill in your values

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# MongoDB (only for production; docker-compose dev uses its own config)
MONGODB_URI=mongodb://atkplan:atkplan_secret@mongo:27017/atkplan?authSource=admin

# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173
UPLOAD_DEST=./uploads

# Frontend
VITE_API_URL=http://localhost:3000
