# Copy this file to .env and fill in your values

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# MongoDB (only for production; docker-compose dev uses its own config)
MONGODB_URI=mongodb://atkplan:atkplan_secret@mongo:27017/atkplan?authSource=admin

# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173
UPLOAD_DEST=./uploads

# Avatar storage — Cloudflare R2 (ou MinIO local para dev)
# Dev (MinIO via Docker): as vars abaixo já estão no docker-compose.yml, não precisa configurar aqui
# Produção (R2 real): remova R2_ENDPOINT e preencha R2_ACCOUNT_ID + credenciais do R2
R2_ENDPOINT=            # deixar vazio em produção; ex dev: http://minio:9000
R2_ACCOUNT_ID=          # apenas para R2 real (ignorado quando R2_ENDPOINT estiver definido)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=          # dev: http://localhost:9000/claudio-avatars | prod: https://pub-xxx.r2.dev

# Frontend
VITE_API_URL=http://localhost:3000
