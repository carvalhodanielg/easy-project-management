# Template for the real `.env.prod` that lives ONLY on the VPS (never commit
# the real file — it stays out of git, see .gitignore).
# Used by docker-compose.prod.yml: `mongo` and `backend` both load this file
# via `env_file`, so it holds vars for both containers.

# --- App ---
NODE_ENV=production
PORT=3000

# --- Auth (backend/src/config/configuration.ts) ---
# JWT_SECRET: gerar com `openssl rand -base64 48`. Sem isso o backend falha
# ao subir em produção (falha rápida proposital, ver resolveJwtSecret()).
JWT_SECRET=<gerar-com-openssl-rand--base64-48>
JWT_EXPIRES_IN=15m
# Duração do refresh token, em dias.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# --- MongoDB ---
# Credenciais do usuário root do container `mongo` (imagem oficial as usa
# para inicializar o admin). Escolha usuário/senha fortes.
MONGO_INITDB_ROOT_USERNAME=atkplan
MONGO_INITDB_ROOT_PASSWORD=<senha-forte>
# String de conexão do backend: host `mongo` é o nome do serviço na rede
# interna do compose (não é acessível de fora); authSource=admin porque o
# usuário foi criado no banco admin pelas envs MONGO_INITDB_ROOT_*.
MONGODB_URI=mongodb://atkplan:<senha-forte>@mongo:27017/atkplan?authSource=admin

# --- CORS / frontend (backend/src/config/configuration.ts -> frontendUrl) ---
FRONTEND_URL=https://app.SEUDOMINIO.com

# --- Seed do admin único (backend/src/modules/.../seed.service.ts) ---
# Em produção o seed só roda se SEED_ADMIN_PASSWORD estiver definido
# (registro é invite-only, essa é a única conta inicial).
SEED_ADMIN_EMAIL=admin@seudominio.com
SEED_ADMIN_PASSWORD=<senha-admin-forte>

# --- Cloudflare R2 (backend/src/common/r2/r2-storage.service.ts) ---
# R2_ENDPOINT vazio = usa o endpoint real da Cloudflare
# (https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com); só preencha com uma URL
# custom para apontar a um storage compatível com S3 (ex: MinIO em dev).
R2_ENDPOINT=
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=claudio-prod
# URL pública de leitura do bucket (domínio r2.dev ou domínio custom).
R2_PUBLIC_URL=https://<bucket-publico>.r2.dev

# --- Opcionais (configuration.ts já tem defaults sensatos; só descomente
# para sobrescrever) ---
# Validade do link de convite de space, em dias (default: 7).
# INVITATION_EXPIRES_IN_DAYS=7
# Validade do link de reset de senha, em minutos (default: 60).
# PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# Envia link de verificação de e-mail no registro (default: false; registro
# é invite-only, então o convite já prova a posse do e-mail).
# EMAIL_VERIFICATION_ENABLED=false
# Validade do link de verificação de e-mail, em horas (default: 24).
# EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
# Pasta de upload local (default: ./uploads) — não usada em produção, pois
# avatares/anexos vão para o R2 via R2_*.
# UPLOAD_DEST=./uploads
